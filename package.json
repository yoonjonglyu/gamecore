{
  "name": "ryuis-gamecore",
  "version": "1.1.0",
  "description": "Headless universal game state & simulation core engine. Zero-dependency pure TypeScript. ECS, EventBus, deterministic PRNG, stat pipeline, pluggable combat, spatial hash, dialogue, FOV, behavior tree, gacha, hierarchy & delta-sync.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yoonjonglyu/gamecore.git"
  },
  "homepage": "https://github.com/yoonjonglyu/gamecore#readme",
  "bugs": {
    "url": "https://github.com/yoonjonglyu/gamecore/issues"
  },
  "keywords": [
    "game-engine",
    "ecs",
    "entity-component-system",
    "headless",
    "zero-dependency",
    "gamecore",
    "deterministic",
    "roguelike",
    "rpg",
    "gacha",
    "behavior-tree",
    "spatial-hash",
    "multiplayer-sync",
    "state-machine",
    "fsm",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "plugin.json",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit && vitest run && tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "author": "ISA (Yoonjong Ryu)",
  "license": "Apache-2.0"
}
