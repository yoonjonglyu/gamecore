{
  "name": "ryuis-gamecore",
  "version": "1.2.0",
  "description": "Headless universal game state & simulation core engine. Zero-dependency pure TypeScript. ECS, EventBus, deterministic PRNG, stat pipeline, pluggable combat, spatial hash, dialogue, FOV, behavior tree, gacha, hierarchy & delta-sync.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/entries/core.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/entries/core.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./combat": {
      "import": {
        "types": "./dist/entries/combat.d.ts",
        "default": "./dist/combat/index.js"
      },
      "require": {
        "types": "./dist/entries/combat.d.cts",
        "default": "./dist/combat/index.cjs"
      }
    },
    "./spatial": {
      "import": {
        "types": "./dist/entries/spatial.d.ts",
        "default": "./dist/spatial/index.js"
      },
      "require": {
        "types": "./dist/entries/spatial.d.cts",
        "default": "./dist/spatial/index.cjs"
      }
    },
    "./serialization": {
      "import": {
        "types": "./dist/entries/serialization.d.ts",
        "default": "./dist/serialization/index.js"
      },
      "require": {
        "types": "./dist/entries/serialization.d.cts",
        "default": "./dist/serialization/index.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/entries/ai.d.ts",
        "default": "./dist/ai/index.js"
      },
      "require": {
        "types": "./dist/entries/ai.d.cts",
        "default": "./dist/ai/index.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/entries/data.d.ts",
        "default": "./dist/data/index.js"
      },
      "require": {
        "types": "./dist/entries/data.d.cts",
        "default": "./dist/data/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yoonjonglyu/gamecore.git"
  },
  "homepage": "https://github.com/yoonjonglyu/gamecore#readme",
  "bugs": {
    "url": "https://github.com/yoonjonglyu/gamecore/issues"
  },
  "keywords": [
    "game-engine",
    "ecs",
    "entity-component-system",
    "headless",
    "zero-dependency",
    "gamecore",
    "deterministic",
    "roguelike",
    "rpg",
    "gacha",
    "behavior-tree",
    "spatial-hash",
    "multiplayer-sync",
    "state-machine",
    "fsm",
    "typescript"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "plugin.json",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node scripts/fix-dts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node --input-type=module -e \"Promise.all([import('./dist/index.js'), import('./dist/core/index.js'), import('./dist/serialization/index.js')]).then(([m, c, s]) => { if (!m.World || !c.CommandBus || !s.SnapshotBuffer) throw new Error('ESM Smoke failed'); })\" && node -e \"const m = require('./dist/index.cjs'); const c = require('./dist/core/index.cjs'); const s = require('./dist/serialization/index.cjs'); if (!m.World || !c.CommandBus || !s.SnapshotBuffer) throw new Error('CJS Smoke failed'); console.log('Smoke test passed (ESM & CJS)!')\"",
    "prepublishOnly": "tsc --noEmit && vitest run && pnpm run build && pnpm run smoke"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "author": "ISA (Yoonjong Ryu)",
  "license": "Apache-2.0"
}
